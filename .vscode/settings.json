{
  // Use the API's virtualenv (not the system Python), so imports resolve and Black runs with the project's settings
  "python-envs.defaultEnvManager": "ms-python.python:venv",
  "python.defaultInterpreterPath": "${workspaceFolder}/api/env/bin/python",

  // Python: Black on save. Your global default formatter (Prettier) cannot format Python, so it did nothing.
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true
  }
}
