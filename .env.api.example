# Copy to .env.api in ~/chatwave on the server. Passed to the API container.
# DATABASE_URL, CORS_ALLOW_ORIGINS and COOKIE_SECURE are set by docker-compose.yml.

# Signs the guest session cookie. Generate: openssl rand -base64 48
# Changing it signs every guest out for good, so keep it stable.
SECRET_KEY=

OPENAI_API_KEY=
CLAUDE_API_KEY=

AWS_REGION=eu-west-3
S3_BUCKET=chatwave
# Leave these out when the EC2 instance has an IAM role with access to the bucket
# (recommended; see DEPLOY.md).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional limits (defaults shown)
# MAX_PROJECTS_PER_USER=5
# MAX_DOCUMENTS_PER_PROJECT=10
# MAX_MESSAGES_PER_MINUTE=10
