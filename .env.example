# Copy to .env in ~/chatwave on the server. Read by docker compose itself
# (for ${...} in docker-compose.yml), not passed to the containers.

DOMAIN=chatwave.asrar.software
# GitHub user/org that owns the images on ghcr.io, lowercase.
IMAGE_OWNER=yaserrar
# Rewritten by the deploy workflow on every release (commit SHA).
IMAGE_TAG=latest
# Password of the chatwave database. Use hex so it needs no URL-encoding:
#   openssl rand -hex 24
DB_PASSWORD=
