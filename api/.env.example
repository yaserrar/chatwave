# Copy to .env and fill in. Never commit the real file.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatwave
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# Signs the guest session cookie. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
SESSION_COOKIE_NAME=cw_session
SESSION_MAX_AGE_DAYS=90
# Set to true when served over HTTPS
COOKIE_SECURE=false

OPENAI_API_KEY=
CLAUDE_API_KEY=

# Private S3 bucket for uploaded files
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
S3_BUCKET=

# Limits (optional, defaults shown)
MAX_PROJECTS_PER_USER=5
MAX_DOCUMENTS_PER_PROJECT=10
MAX_MESSAGES_PER_MINUTE=10
MAX_REQUESTS_PER_MINUTE=120
MAX_GUESTS_PER_IP_PER_HOUR=10
