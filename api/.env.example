# Copy to .env and fill in. Never commit the real file.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatwave
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
# Print every SQL query in the logs
SQL_ECHO=false

# Signs the guest session cookie. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
SESSION_COOKIE_NAME=cw_session
SESSION_MAX_AGE_DAYS=90
# Set to true when served over HTTPS
COOKIE_SECURE=false

# Embeddings (OpenAI) and answers (Claude)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CLAUDE_API_KEY=
LLM_MODEL=claude-opus-5-5

# Private S3 bucket. Leave the keys empty on EC2 with an IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
S3_BUCKET=
# Seconds a preview/download link stays valid
PRESIGNED_URL_EXPIRES=300

# Limits (optional, defaults shown)
MAX_PROJECTS_PER_USER=5
MAX_DOCUMENTS_PER_PROJECT=10
MAX_MESSAGES_PER_MINUTE=10
MAX_REQUESTS_PER_MINUTE=120
MAX_GUESTS_PER_IP_PER_HOUR=10
